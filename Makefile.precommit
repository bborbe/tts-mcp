.PHONY: precommit
# Run all precommit checks (sync is defined in main Makefile)
precommit: sync format test check
	@echo "All precommit checks passed"

.PHONY: format
# Format code with ruff
format:
	uv run ruff format .
	uv run ruff check --fix . || true

.PHONY: lint
# Lint code with ruff
lint:
	uv run ruff check .

.PHONY: typecheck
# Type check with mypy and pyright
typecheck:
	uv run mypy src
	uv run pyright

.PHONY: mcp-typecheck
# Type check the TypeScript MCP relay in mcp/ (npm ci installs the exact lockfile tree)
mcp-typecheck:
	cd mcp && npm ci && npx tsc --noEmit

.PHONY: check
# Run lint and typecheck (Python) plus the MCP relay typecheck
check: lint typecheck mcp-typecheck

.PHONY: test
# Run tests with pytest (includes tests/architecture)
test: sync
	uv run pytest
